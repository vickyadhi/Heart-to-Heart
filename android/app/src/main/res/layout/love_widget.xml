<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="12dp">

    <!-- TOP ROW: Heart icon + Partner name + status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <!-- Tappable Heart Badge (opens app) -->
        <TextView
            android:id="@+id/widget_main_heart"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:text="❤️"
            android:textSize="20sp"
            android:gravity="center"
            android:background="@drawable/widget_emoji_bg" />

        <!-- Partner Info Column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="8dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Partner"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/widget_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="No taps yet"
                android:textColor="#CCFFFFFF"
                android:textSize="10sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif" />
        </LinearLayout>

        <!-- h2h Branding pill -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="h2h"
            android:textColor="#AAFFFFFF"
            android:textSize="9sp"
            android:textStyle="bold"
            android:background="@drawable/widget_brand_pill"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <!-- Divider (Using ImageView to prevent inflation crash on custom launchers) -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#25FFFFFF"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp" />

    <!-- STICKY NOTE SECTION (resizable/fills available vertical space) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/widget_note_paper"
        android:padding="8dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="2dp">
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📌 Note from Partner"
                android:textColor="#80505050"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_note_text"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="No notes yet"
            android:textColor="#333333"
            android:textSize="11sp"
            android:lineSpacingMultiplier="1.1"
            android:ellipsize="end"
            android:fontFamily="sans-serif" />
    </LinearLayout>

    <!-- Divider (Using ImageView) -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#25FFFFFF"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp" />

    <!-- BOTTOM ROW: 4 Emoji Quick-Send Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:weightSum="4">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:id="@+id/widget_emoji_miss_you"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:text="🥺"
                android:textSize="22sp"
                android:gravity="center"
                android:background="@drawable/widget_emoji_bg" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:id="@+id/widget_emoji_sad"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:text="😢"
                android:textSize="22sp"
                android:gravity="center"
                android:background="@drawable/widget_emoji_bg" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:id="@+id/widget_emoji_excited"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:text="🤩"
                android:textSize="22sp"
                android:gravity="center"
                android:background="@drawable/widget_emoji_bg" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:id="@+id/widget_emoji_thinking"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:text="💭"
                android:textSize="22sp"
                android:gravity="center"
                android:background="@drawable/widget_emoji_bg" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
