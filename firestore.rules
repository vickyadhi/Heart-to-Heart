rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ──────────────────────────────────────────────
    // HELPER FUNCTIONS
    // ──────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    // Check if the user is part of a conversation
    // convoId format: uid1_uid2 (lexicographic order)
    function isConvoMember(convoId) {
      let parts = convoId.split('_');
      return parts[0] == request.auth.uid || parts[1] == request.auth.uid;
    }

    // ──────────────────────────────────────────────
    // CONFIG (FCM Service Account — read-only for auth users)
    // ──────────────────────────────────────────────
    match /config/{docId} {
      allow read: if isAuth();
      allow write: if false; // Only writable from Firebase Console
    }

    // ──────────────────────────────────────────────
    // USER PROFILES
    // ──────────────────────────────────────────────
    match /users/{uid} {
      // Owner can always read/write their own profile
      allow read, write: if isAuth() && isOwner(uid);

      // Any authenticated user can read another user's basic profile
      // (needed to fetch partner info, fcmToken, battery level, etc.)
      allow read: if isAuth();

      // Partner can update pairing-related fields on your profile
      allow update: if isAuth()
        && !isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['partnerUid', 'partnerName', 'connectedAt', 'pairingCode', 'fcmToken']);
    }

    // ──────────────────────────────────────────────
    // PAIRING CODES
    // ──────────────────────────────────────────────
    match /pairing_codes/{code} {
      allow read: if isAuth();
      allow create: if isAuth()
        && request.resource.data.creatorUid == request.auth.uid;
      allow update: if isAuth();
      allow delete: if isAuth();
    }

    // ──────────────────────────────────────────────
    // CONVERSATIONS & LOVE EVENTS
    // ──────────────────────────────────────────────
    match /conversations/{convoId} {
      // Only the two users in the conversation can read/write
      allow read, write: if isAuth() && isConvoMember(convoId);

      match /events/{eventId} {
        // Both partners can read all events
        allow read: if isAuth() && isConvoMember(convoId);

        // Only the sender can create events
        allow create: if isAuth()
          && isConvoMember(convoId)
          && request.resource.data.senderId == request.auth.uid;

        // Either partner can delete events (cleanup)
        allow delete: if isAuth() && isConvoMember(convoId);

        // Allow update (e.g. reactions)
        allow update: if isAuth() && isConvoMember(convoId);
      }

      // ── MESSAGES sub-collection ──
      match /messages/{messageId} {
        allow read: if isAuth() && isConvoMember(convoId);
        allow create: if isAuth()
          && isConvoMember(convoId)
          && request.resource.data.senderId == request.auth.uid;
        allow update: if isAuth() && isConvoMember(convoId);
        allow delete: if isAuth() && isConvoMember(convoId);
      }
    }
  }
}
