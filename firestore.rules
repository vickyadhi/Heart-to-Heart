rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ──────────────────────────────────────────────
    // USER PROFILES
    // ──────────────────────────────────────────────
    match /users/{uid} {
      // Any authenticated user can read their own profile, or if they are the partner of this user
      allow read: if request.auth != null 
        && (request.auth.uid == uid || resource.data.partnerUid == request.auth.uid);
      
      // Create: only the owner (on first sign-up / Google sign-in)
      allow create: if request.auth != null && request.auth.uid == uid;
      
      // Update own profile
      allow update: if request.auth != null && request.auth.uid == uid;
      
      // Partner can update certain fields on YOUR profile during pairing
      // (setting partnerUid, partnerName, connectedAt on the code creator)
      allow update: if request.auth != null 
        && request.auth.uid != uid
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['partnerUid', 'partnerName', 'connectedAt', 'pairingCode', 'fcmToken']);
    }

    // ──────────────────────────────────────────────
    // PAIRING CODES
    // ──────────────────────────────────────────────
    match /pairing_codes/{code} {
      // Any authenticated user can read a pairing code (to verify it)
      allow read: if request.auth != null;
      
      // Only authenticated users can create a pairing code for themselves
      allow create: if request.auth != null 
        && request.resource.data.creatorUid == request.auth.uid;
      
      // Allow updates (requester setting requesterUid, creator accepting/rejecting)
      allow update: if request.auth != null;
      
      // Deleting pairing codes (after successful pairing)
      allow delete: if request.auth != null;
    }

    // ──────────────────────────────────────────────
    // CONVERSATIONS & LOVE EVENTS
    // ──────────────────────────────────────────────
    match /conversations/{convoId} {
      // Allow if the authenticated user's UID appears in the convoId
      // (convoId format: uid1_uid2 where uid1 < uid2 lexicographically)
      allow read, write: if request.auth != null 
        && (convoId.matches('.*' + request.auth.uid + '.*'));
      
      match /events/{eventId} {
        allow read: if request.auth != null 
          && (convoId.matches('.*' + request.auth.uid + '.*'));
        
        allow create: if request.auth != null 
          && request.resource.data.senderId == request.auth.uid
          && (convoId.matches('.*' + request.auth.uid + '.*'));
        
        allow delete: if request.auth != null
          && (convoId.matches('.*' + request.auth.uid + '.*'));
      }
    }
  }
}
